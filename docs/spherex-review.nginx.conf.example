# EXAMPLE ONLY: adapt the upstream to the site's existing WSGI deployment.
# Include inside an HTTPS server block, before generic regex locations.
# The URL fragment credential form never sends a password in the initial URL.
#
# Disable request recording at every layer (including Passenger/Gunicorn and
# hosting-panel logs). Do not apply this file blindly to the running site.
location ~ ^/(?:js/)?(?:spherex-(?:autotype|review)|api/spherex-review/[^/]+|static/spherex_review\.(?:html|css|js)|plotly\.min\.js)$ {
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;

    # Replace with the actual mocaviz upstream; preserve root and /js paths.
    proxy_pass http://127.0.0.1:8050;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
}
