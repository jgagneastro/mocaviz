# Merge this location into the existing HTTPS mocadb.ca server block.
# It routes only this private planner; other MOCAviz pages keep their backend.
# Ensure it precedes broader regex locations and is not overridden by ^~ rules.
location ~ ^/(?:js/)?(?:gnirs-planner/?$|api/gnirs/|static/gnirs_planner/) {
    # Uncomment when this Nginx build has Passenger enabled above this location:
    # passenger_enabled off;
    access_log off;
    error_log /dev/null;
    log_not_found off;
    client_max_body_size 64k;
    client_body_buffer_size 128k;
    client_body_in_file_only off;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_cache off;
    proxy_store off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 180s;
    proxy_pass http://127.0.0.1:8796;
}
